# ─────────────────────────────────────────────────────────────
# QuantFolio 환경변수 예시 — cp .env.example .env
# 비밀(마스터 키·증권사/외부 API 키)은 여기 말고 secrets/*.txt 에 둔다(secrets/README.md).
# 같은 이름의 평문 변수도 읽지만 시크릿 파일이 우선한다 — 운영에선 비워 둔다.
# 원본(Python)의 *_FILE·KIS_BASE_URL_*·KIS_WS_URL_*·TOSS_BASE_URL 은 읽지 않는다(엔드포인트는 코드 고정).
# ─────────────────────────────────────────────────────────────

# --- 실행 환경 --- dev: 누락 시크릿 임시 생성 / prod: 필수 시크릿 누락·약한 키·비보안 쿠키면 부팅 거부
APP_ENV=dev

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant
POSTGRES_DB=quant
# compose 는 DATABASE_JDBC_URL 을 db 서비스로 고정한다. 로컬(비-Docker) 실행 때만:
# DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/quant
# REDIS_URL=redis://localhost:6379/0

# --- 인증(서버측 세션, 분 단위 슬라이딩 TTL — 기본 14일) ---
SESSION_TTL_MINUTES=20160
# 운영(HTTPS)에서는 COOKIE_SECURE=true 필수. 단일 출처(proxy) 운용 기본값은 lax(원본과 같음).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# 자동매매·증권사 연결을 사용할 기존 사용자 ID. 비우면 모두 차단된다.
TRADING_OWNER_USER_ID=

# --- 한국투자증권 KIS --- 기본 모의투자(vts).
# 실전(prod)은 KIS_PROD_APPROVED=true 까지 둘 다 있어야 부팅된다(2단계 승인).
KIS_ENV=vts
KIS_PROD_APPROVED=false
KIS_ACCOUNT_NO=   # 'CANO-PRDT' 형식(예: 50012345-01). 비밀 아님.
KIS_HTS_ID=       # 실시간 체결통보 구독용 HTS ID. 비밀 아님.
# 실전 하루 주문 명목 상한(원). 비우면 검사 생략.
KIS_DAILY_ORDER_NOTIONAL_CAP=

# --- 토스증권(선택) --- REST 전용·모의투자 없음(항상 실거래).
TOSS_ACCOUNT_NO=  # =accountSeq. 비밀 아님.

# --- DB 백업 오프사이트 복제(선택) --- 버킷·자격증명 중 하나라도 비면 로컬 백업만.
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT_URL=   # AWS S3 는 비움. R2/B2/MinIO 는 S3 호환 엔드포인트.
S3_BACKUP_REGION=auto
S3_BACKUP_PREFIX=quantfolio-db-backups/

# --- CORS / 에러 상세 ---
# 단일 출처(proxy)에선 CORS 가 트리거되지 않는다. :8000 직접 개발 때만 의미.
FRONTEND_ORIGIN=http://localhost:3000
# true 면 처리 안 된 예외 상세를 응답에 담는다. APP_ENV=prod 에선 강제로 false.
DEBUG_ERRORS=false

# --- Frontend (Next.js) --- proxy 경유 표준 운용에선 반드시 비워 둔다(상대경로 호출).
NEXT_PUBLIC_API_BASE_URL=

# --- 외부 접속(proxy) ---
APP_PORT=8080
HTTPS_PORT=443
WG_HOST=10.8.0.1   # HTTPS 자체 서명 인증서 대상 = WireGuard 인터페이스 IP

# --- 호스트 포트(127.0.0.1 바인딩). 다른 스택과 나란히 띄울 때만 바꾼다 ---
# DB_PORT=5432
# REDIS_PORT=6379
# WEB_PORT=8000
# FRONTEND_PORT=3000
